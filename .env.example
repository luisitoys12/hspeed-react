# .env.example — copy to .env and fill in real values
# This file is safe to commit. Never commit the actual .env.

# ── Application ──────────────────────────────────────────────
APP_PORT=5000
NODE_ENV=production

# ── Secrets (runtime only — NEVER embed in Docker ARG/image) ─
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=another_long_random_string

# ── Database ─────────────────────────────────────────────────
# Variant A — Supabase / external Postgres (recommended for prod):
# DATABASE_URL=postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres
# PGSSL=true

# Variant B — Local Postgres container (dev / staging):
DB_USER=hspeed
DB_PASSWORD=hspeed
DB_NAME=hspeed
DATABASE_URL=postgres://hspeed:hspeed@db:5432/hspeed
PGSSL=false

# ── VITE_* (build-time — embedded in JS bundle, NOT secrets) ─
# These go as --build-arg to docker build (or in GitHub Actions secrets).
# They will be VISIBLE in the compiled frontend bundle.
VITE_API_URL=https://your-domain.com
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
