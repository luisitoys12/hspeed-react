# HSpeed V1 - Environment Configuration (Laravel + React)
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=
VITE_API_URL_PRODUCTION=https://api.hspeed.com/api

# Laravel
APP_KEY=base64:your-laravel-app-key-here
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hspeed
DB_USERNAME=root
DB_PASSWORD=

# Supabase (optional, for future use)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_KEY=your-service-key

# Database
DB_HOST_DB=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me

# Radio
RADIO_LISTEN_URL=https://your-radio-stream.url
RADIO_STATION_ID=your-zeno-station-id

# Discord
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token

# Habbo API
HABBO_API_BASE=https://www.habbo.es/api
HABBO_ASSETS_BASE=https://www.habboassets.com/api/v1

# App
VITE_APP_NAME=HSpeed V1
VITE_APP_VERSION=1.0.0
NODE_ENV=development

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_BADGES=true
VITE_ENABLE_RADIO=true
VITE_ENABLE_FORUM=true
VITE_ENABLE_FUTBOL=true

# Analytics (optional)
VITE_JAM_API_KEY=your-jam-api-key
VITE_GOOGLE_ANALYTICS_ID=your-ga-id

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
