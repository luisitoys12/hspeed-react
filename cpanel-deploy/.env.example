# ============================================================
#  hspeed-react — Variables de Entorno (cPanel)
#  Copia este archivo como .env y rellena los valores reales.
#  En cPanel "Setup Node.js App" puedes ponerlas directamente
#  en la sección "Environment Variables".
# ============================================================

# --- General ---
NODE_ENV=production
PORT=3000

# --- Base de datos (PostgreSQL o MySQL) ---
# Ejemplo PostgreSQL (Supabase):
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db
# Ejemplo MySQL (cPanel):
# DATABASE_URL=mysql://usuario:password@localhost/nombre_db
DATABASE_URL=

# Si no tienes base de datos configurada, usa almacenamiento en memoria:
# USE_MEMSTORAGE=true

# --- Autenticación JWT ---
# Cambia esto por una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# --- API de JAM (opcional) ---
VITE_JAM_API_KEY=
VITE_BUILD_VERSION=1.0.0

# --- Proxy / Caché (opcional, valores por defecto) ---
PROXY_CACHE_MAX_BYTES=209715200
PROXY_CACHE_TTL_SECONDS=86400

# --- Supabase (si usas Supabase en lugar de DATABASE_URL) ---
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
